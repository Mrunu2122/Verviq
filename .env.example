# Verviq Environment Configuration

# Next.js Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Credentials
# Retrieve these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# AI Provider Credentials (Google Gemini API)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
# Note: Gemini API keys and quotas are distinct from consumer Gemini Pro/Advanced subscriptions.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Optional Speech-To-Text / Audio Transcription API
DEEPGRAM_API_KEY=
